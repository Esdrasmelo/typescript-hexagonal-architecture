DATABASE_URL="mysql://usuario:senha@localhost:3306/hexagonal"
REDIS_URL="redis://localhost:6379"
MONGO_URL="mongodb://localhost:27017"
MONGO_DATABASE=hexagonal

APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

JWT_SECRET=
JWT_EXPIRES_IN=1d

LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

CACHE_NAMESPACE=hexagonal
CACHE_TTL_SECONDS=60

QUEUE_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_MILLISECONDS=1000
QUEUE_KEEP_COMPLETED=500
QUEUE_KEEP_FAILED=5000

AUDIT_RETENTION_DAYS=180
READINESS_TIMEOUT_MILLISECONDS=2000

# Portas publicadas pelo docker compose quando você já tem Redis ou Mongo na máquina
REDIS_HOST_PORT=6380
MONGO_HOST_PORT=27017
